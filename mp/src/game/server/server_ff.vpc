//-----------------------------------------------------------------------------
//	SERVER_FF.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"ff" [!$SOURCESDK]
$Macro GAMENAME 	"FortressForever2013" [$SOURCESDK] // TEMP!!

$Include "$SRCDIR\game\server\server_base.vpc"
$Include "$SRCDIR\game\server\nav_mesh.vpc" [$SOURCESDK]

$Include "$SRCDIR\game\shared\ff\ff_shared.vpc"

$Macro THIRDPARTY	"$SRCDIR\thirdparty"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$THIRDPARTY\LuaBridge3,$THIRDPARTY\lua-5.1.5\include,$SRCDIR\game\shared\ff\buildables\base,$SRCDIR\game\shared\ff\buildables,$SRCDIR\game\shared\ff\grenades,$SRCDIR\game\shared\ff\projectiles,$SRCDIR\game\shared\ff\weapons,$SRCDIR\game\shared\ff,.\ff\lua,.\ff"
		$PreprocessorDefinitions	"$BASE;FF;FF_DLL;SDK2013CE"
		
		$AdditionalOptions		"$BASE /std:c++17"
	}
}

$Project "Server (FF)"
{
	$Folder "FF Source Files"
	{		
		$Folder "Lua"
		{
			$File "$SRCDIR\game\server\ff\lua\ff_entity_system.cpp"
